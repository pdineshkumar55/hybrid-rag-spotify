OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
# Leave empty to use the default database. On newer Aura instances it is the instance ID, not 'neo4j'.
NEO4J_DATABASE=

FAISS_INDEX_DIR=vectorstore
PDF_PATH=data/raw/spotify_web_app_architecture.pdf
API_BASE_URL=http://localhost:8000

# Optional: required as X-Admin-Token header for POST /ingest
ADMIN_TOKEN=

