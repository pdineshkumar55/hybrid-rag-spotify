OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
# Leave empty to use the default database. On newer Aura instances it is the instance ID, not 'neo4j'.
NEO4J_DATABASE=

FAISS_INDEX_DIR=vectorstore
PDF_PATH=data/raw/spotify_web_app_architecture.pdf
API_BASE_URL=http://localhost:8000

# Optional: required as X-Admin-Token header for POST /ingest
ADMIN_TOKEN=

# ---- Retrieval & answer tuning (defaults shown) ----
# Rewrite the question into the document's vocabulary before searching
QUERY_EXPANSION=true
# Don't wait for expansion when the direct FAISS match is at least this strong
EXPANSION_SKIP_MIN_SCORE=0.55
# Generate a read-only Cypher query for counting / ranking questions
TEXT2CYPHER=true
# auto = skip the verification call when fast checks pass | always | never
VERIFY_MODE=auto
VERIFY_SKIP_MIN_SCORE=0.5
# Seconds to cache answers for repeated questions (0 = off)
ANSWER_CACHE_TTL_S=3600

# ---- Server only: public domain + login for Traefik ----
# RAG_DOMAIN=rag.dinesh-genai.tech
# Generate with:  htpasswd -nbB <user> '<password>'   and wrap the result in SINGLE quotes
# BASIC_AUTH_USERS='dinesh:$2y$05$....'
